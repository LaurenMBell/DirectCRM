<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Clients</h1>
      <p>Add, update, and delete clients</p>
    </div>
  </div>

  <table class="table table-hover">
    <thead>
      <tr>
        <th>Client ID</th>
        <th>Client Name</th>
        <th>Revenue</th>
      </tr>
    </thead>
    <tbody>
      <% clients.forEach(function(client) { %>
        <tr>
          <td><%= client.ClientID %></td>
          <td><%= client.ClientName %></td>
          <td>$<%= Number(client.Revenue).toLocaleString() %></td> 
        </tr>
      <% }); %>
    </tbody>
  </table>

  <hr>

  <!-- Add New Client -->
  <div>
    <h3>Add new Client</h3>
    <form action="/clients/add" method="POST">
      <label for="clientname">Client Name:</label><br>
      <input type="text" id="clientname" name="clientname" required><br>
      <label for="clientid">ClientID:</label><br>
      <input type="text" id="clientid" name="clientid" required><br>
      <label for="revenue">Revenue:</label><br>
      <input type="number" id="revenue" name="revenue" required><br>
      <button type="submit" class="btn btn-primary mt-2">Add new Client</button>
    </form>
  </div>

  <hr>

  <!-- Update Client -->
  <div>
    <h3>Update Client Revenue</h3>
    <form action="/clients/update" method="POST">
      <label for="update-clientid">Select Client to Update:</label><br>
      <select name="clientid" id="update-clientid" required>
        <% clients.forEach(function(client) { %>
          <option value="<%= client.ClientID %>"><%= client.ClientName %></option>
        <% }); %>
      </select><br>
      <label for="new-revenue">New Revenue:</label><br>
      <input type="number" id="new-revenue" name="revenue" required><br>
      <button type="submit" class="btn btn-secondary mt-2">Update Revenue</button>
    </form>
  </div>

  <hr>

  <!-- Remove Client -->
  <div>
    <h3>Remove Client</h3>
    <form action="/clients/delete" method="POST">
      <label for="remove-clientid">Choose a client to remove:</label><br>
      <select name="clientid" id="remove-clientid" required>
        <% clients.forEach(function(client) { %>
          <option value="<%= client.ClientID %>"><%= client.ClientName %></option>
        <% }); %>
      </select><br>
      <button type="submit" class="btn btn-danger mt-2">Remove Client</button>
    </form>
  </div>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>