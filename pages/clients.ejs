<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Clients</h1>
      <p>Add, update, and delete clients</p>
    </div>
  </div>

  <div>
    <% clients.forEach(function(client) { %>
      <tr>
        <td><%= client.ClientName %></td>
      </tr>
    <% }); %>
  </div>

  <p></p>
  <div>
    <h3>Add new Client</h3>
    <form>
      <label for="clientname">Client Name:</label><br>
      <input type="text" id="clientname" name="clientname"><br>
      <label for="clientid">ClientID:</label><br>
      <input type="text" id="clientid" name="clientid"><br>
      <label for="revenue">Revenue:</label><br>
      <input type="text" id="revenue" name="revenue"><br>
      
      <button type="submit">Add new Client</button>
    </form>
  </div>

  <p></p>
  <form>
    <div>
      <h3>Remove Client</h3>
      <label for="clients">Choose a client to remove:</label>
      <select name="clients" id="clients">
        <option value="nike">Nike</option>
        <option value="osu">Oregon State University</option>
        <option value="flirsystems">FLIR Systems</option>
      </select><br>
      
      <button type="submit">Remove Client</button>
    </div>
  </form>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>
