<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Licenses</h1>
      <p>Add, update, and delete licenses</p>
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Product ID</th>
          <th>License ID</th>
          <th>Expiration</th>
          <th>User ID</th>
        </tr>
      </thead>
      <tbody>
        <% licenses.forEach(function(license) { %>
          <tr>
            <td><%= license.ProductID %></td>
            <td><%= license.LicenseID %></td>
            <td><%= license.Expiration %></td>
            <td><%= license.UserID %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="flex-container">
    <div class="column">
      <h3>Add new License</h3>
      <form action="/licenses/add-new-license" method="POST">
        <label for="productid"> ProductID:</label><br>
        <input type="text" id="productid" name="productid"><br>
        <label for="licenseid">LicenseID:</label><br>
        <input type="text" id="licenseid" name="licenseid"><br>
        <label for="expiration">Expiration:</label><br>
        <input type="text" id="expiration" name="expiration"><br>
        <label for="userid">UserID:</label><br>
        <input type="text" id="userid" name="userid"><br>
        
        <button type="submit">Add new License</button>
      </form>
    </div>
    <div class="column">
      <form action="/licenses/delete-license" method="POST">
        <h3>Remove License</h3>
        <label for="licenseid">Choose a license to remove:</label>
        <select name="licenseid" id="licenseid">
          <% licenses.forEach(function(license) { %>
            <option value="<%= license.LicenseID %>">License: <%= license.LicenseID %> (User: <%= license.UserID %>, Product: <%= license.ProductID %>)</option>
          <% }); %>
        </select><br><br>
        
        <button type="submit">Remove License</button>
    </form>
    </div>
  </div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>