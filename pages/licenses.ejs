<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Licenses</h1>[cite: 5]
      <p>Add, update, and delete licenses</p>[cite: 5]
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Product ID</th>
          <th>License ID</th>
          <th>Expiration</th>
          <th>User ID</th>
        </tr>
      </thead>
      <tbody>
        <% licenses.forEach(function(license) { %>
          <tr>
            <td><%= license.ProductID %></td>
            <td><%= license.LicenseID %></td>
            <td><%= license.Expiration %></td>
            <td><%= license.UserID %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <p></p>
  <div>
    <h3>Add new License</h3>[cite: 5]
    <form action="/licenses/add" method="POST">
      <label for="productid"> ProductID:</label><br>
      <input type="text" id="productid" name="productid"><br>
      <label for="licenseid">LicenseID:</label><br>
      <input type="text" id="licenseid" name="licenseid"><br>
      <label for="expiration">Expiration:</label><br>
      <input type="text" id="expiration" name="expiration"><br>
      <label for="userid">UserID:</label><br>
      <input type="text" id="userid" name="userid"><br>
      
      <button type="submit">Add new License</button>
    </form>
  </div>

  <p></p>
  <div>
    <h3>Remove License</h3>[cite: 5]
    <form action="/licenses/delete" method="POST">
      <div>
        <label for="licenseid-select">Choose a license to remove:</label><br>
        <select name="licenseid" id="licenseid-select">
          <% licenses.forEach(function(license) { %>
            <option value="<%= license.LicenseID %>"><%= license.LicenseID %> (User: <%= license.UserID %>)</option>
          <% }); %>
        </select><br>
        
        <button type="submit">Remove License</button>
      </div>
    </form>
  </div>

</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>