<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Users</h1>
      <p>Add, update, and delete users</p>
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>User ID</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Client ID</th>
          <th>Password</th>
          <th>Security Question</th>
          <th>Security Answer</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(user) { %>
          <tr>
            <td><%= user.UserID %></td>
            <td><%= user.fNameUser %></td>
            <td><%= user.lNameUser %></td>
            <td><%= user.ClientID %></td>
            <td><%= user.Password %></td>
            <td><%= user.SecurityQuestion %></td>
            <td><%= user.SecurityAnswer %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div>
  <h3>Add New User</h3>
  <form action="/users/add-new-user" method="POST">
    <label for="userid">User ID:</label><br>
    <input type="text" id="userid" name="userid"><br>
    <label for="fname">First Name:</label><br>
    <input type="text" id="fname" name="fname"><br>
    <label for="lname">Last Name:</label><br>
    <input type="text" id="lname" name="lname"><br>
    <label for="clientid">ClientID:</label><br>
    <input type="text" id="clientid" name="clientid"><br>
    <label for="password">Password:</label><br>
    <input type="text" id="password" name="password"><br>
  
    <label for="securityquestion">Security Question:</label><br>
    <input type="text" id="securityquestion" name="securityquestion"><br>
    <label for="securityanswer">Security Answer:</label><br>
    <input type="text" id="securityanswer" name="securityanswer"><br>
      
    <button type="submit">Add User</button>
  </form>
</div>

<div>
  <form>
    <div>
      <h3>Remove User</h3>
      <label for="users">Choose a user to remove:</label>
      <select name="users" id="users">
        <option value="hansel002">hansel002</option>
        <option value="trinity919">trinity919</option>
        <option value="jeremy873">jeremy873</option>
        <option value="thomas987">thomas987</option>
        <option value="sasha487">sasha487</option>
      </select><br>
      
      <button type="submit">Remove User</button>
    </div>
  </form>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>
