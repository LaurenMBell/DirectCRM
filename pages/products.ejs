<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Products</h1>[cite: 6]
      <p>View, launch, and discontinue DirectCRM products</p>[cite: 6]
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Product Name</th>
          <th>Product ID</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(function(product) { %>
          <tr>
            <td><%= product.ProductID %></td>
            <td><%= product.ProductName %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div><br>
  
  <div>
    <h3>Launch New Product</h3>[cite: 6]
    <form action="/products/add" method="POST">
      <label for="productname">Product Name:</label><br>
      <input type="text" id="productname" name="productname"><br>
      <label for="productID">ProductID:</label><br>
      <input type="text" id="productid" name="productid"><br>
      <button type="submit">Launch</button>
    </form>
  </div><br>
  
  <div>
    <h3>Discontinue Product</h3>[cite: 6]
    <form action="/products/delete" method="POST">
      <label for="discontinue-productid">Choose a product to discontinue:</label><br>
      <select name="productid" id="discontinue-productid">
        <% products.forEach(function(product) { %>
          <option value="<%= product.ProductID %>"><%= product.ProductName %> (<%= product.ProductID %>)</option>
        <% }); %>
      </select><br>
      <button type="submit">Discontinue</button>
    </form>
  </div>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>