<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Products</h1>
      <p>View, launch, and discontinue DirectCRM products</p>
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Product Name</th>
          <th>Product ID</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(function(product) { %>
          <tr>
            <td><%= product.ProductName %></td>
            <td><%= product.ProductID %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div><br>
  
  <div class="flex-container">
    <div class="column">
      <h3>Launch New Product</h3>
      <form action="/products/add-new-product" method="POST">
        <label for="productname">Product Name:</label><br>
        <input type="text" id="productname" name="productname"><br>
        <label for="productID">ProductID:</label><br>
        <input type="text" id="productid" name="productid"><br>
        <button type="submit">Launch</button>
      </form>
    </div>
    <div class="column">
      <h3>Discontinue Product</h3>
      <form action="/products/delete-product" method="POST">
        <label for="productid">Choose a product to discontinue:</label><br>
        <select name="productid" id="productid">
          <% products.forEach(function(product) { %>
            <option value="<%= product.ProductID %>"><%= product.ProductName %> (ID: <%= product.ProductID %>)</option>
          <% }); %>
        </select><br><br>
        <button type="submit">Discontinue</button>
      </form>
    </div>
  </div>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>
