<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>User Products</h1>
      <p>Add, update, and delete user products</p>
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>User Product ID</th>
          <th>User ID</th>
          <th>Product ID</th>
        </tr>
      </thead>
      <tbody>
        <% userproducts.forEach(function(userproduct) { %>
          <tr>
            <td><%= userproduct.UserProductsID %></td>
            <td><%= userproduct.UserID %></td>
            <td><%= userproduct.ProductID %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div><br>

  <div class="flex-container">
    <div class="column">
      <h3>Add new Product for User</h3>
      <form action="/userproducts/add-new-userproduct" method="POST">
        <label for="userproductid">UserProduct ID:</label><br>
        <input type="text" id="userproductid" name="userproductid"><br>
        <label for="userid">User ID:</label><br>
        <input type="text" id="userid" name="userid"><br>
        <label for="productid">ProductID:</label><br>
        <input type="text" id="productid" name="productid"><br>
        <button type="submit">Submit</button>
      </form>
    </div>

    <div class="column">
      <form action="/userproducts/update-userproduct" method="POST">
        <h3>Update UserProduct</h3>
        <label for="userproductid">Choose a UserProduct to update:</label><br>
        <select name="userproductid" id="userproductid" required>
          <option value="">Select a UserProduct ID</option>

          <% userproducts.forEach(function(up) { %>
            <option value="<%= up.UserProductsID %>">
              ID: <%= up.UserProductsID %> (User: <%= up.UserID %>, Product: <%= up.ProductID %>)
            </option>
          <% }); %>

        </select><br><br>
        <label for="userid">New User ID:</label><br>
        <input type="text" id="userid" name="userid" required><br>

        <label for="productid">New Product ID:</label><br>
        <input type="text" id="productid" name="productid" required><br><br>

        <button type="submit">Update UserProduct</button>
      </form>
    </div>

    <div class="column">
      <form action="/userproducts/delete-userproduct" method="POST">
        <h3>Remove UserProduct</h3>
        <label for="userproductid_del">Choose a UserProduct to remove:</label><br>
        <select name="userproductid" id="userproductid_del" required>
          <option value="">Select a UserProduct ID</option>
          <% userproducts.forEach(function(up) { %>
            <option value="<%= up.UserProductsID %>">
              ID: <%= up.UserProductsID %> (User: <%= up.UserID %>, Product: <%= up.ProductID %>)
            </option>
          <% }); %>
        </select>
        <button type="submit">Remove UserProduct</button>
      </form>
    </div>
  </div>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>