<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>User Products</h1>[cite: 8]
      <p>Add, update, and delete user products</p>[cite: 8]
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>User Product ID</th>
          <th>User ID</th>
          <th>Product ID</th>
        </tr>
      </thead>
      <tbody>
        <% userproducts.forEach(function(userproduct) { %>
          <tr>
            <td><%= userproduct.UserProductsID %></td>
            <td><%= userproduct.UserID %></td>
            <td><%= userproduct.ProductID %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div><br>

  <div>
    <h3>Add new Product for User</h3>[cite: 8]
    <form action="/userproducts/add" method="POST">
      <label for="userproductid">UserProduct ID:</label><br>
      <input type="text" id="userproductid" name="userproductid"><br>
      <label for="userid">User ID:</label><br>
      <input type="text" id="userid" name="userid"><br>
      <label for="productid">ProductID:</label><br>
      <input type="text" id="productid" name="productid"><br>
      <button type="submit">Submit</button>
    </form>
  </div><br>
  
  <div>
    <h3>Remove UserProduct</h3>[cite: 8]
    <form action="/userproducts/delete" method="POST">
      <label for="remove-userproductid">Choose a UserProduct to remove:</label><br>
      <select name="userproductid" id="remove-userproductid">
        <% userproducts.forEach(function(userproduct) { %>
          <option value="<%= userproduct.UserProductsID %>"><%= userproduct.UserProductsID %> (User: <%= userproduct.UserID %>, Product: <%= userproduct.ProductID %>)</option>
        <% }); %>
      </select><br>
      
      <button type="submit">Remove UserProduct</button>
    </form>
  </div><br>

  <div>
    <h3>Update UserProduct</h3>[cite: 8]
    <form action="/userproducts/update" method="POST">
      <label for="update-userid">Choose a User ID to update:</label><br>
      <select name="userid" id="update-userid">
        <% userproducts.forEach(function(userproduct) { %>
          <option value="<%= userproduct.UserID %>">User: <%= userproduct.UserID %> (Current Product: <%= userproduct.ProductID %>)</option>
        <% }); %>
      </select><br>

      <label for="userproductid-update">UserProduct ID:</label><br>
      <input type="text" id="userproductid-update" name="userproductid"><br>
      <label for="productid-update">ProductID:</label><br>
      <input type="text" id="productid-update" name="productid"><br>
      <button type="submit">Update UserProduct</button>
    </form>
  </div>


</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>
```[cite: 8]