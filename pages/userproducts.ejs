<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>User Products</h1>
      <p>Add, update, and delete user products</p>
    </div>
  </div>

  <div>
    <table>
      <tr>
        <th>User Product ID</th>
        <th>User ID</th>
        <th>Product ID</th>
      </tr>
      <tr>
        <td>UP0001</td>
        <td>hansel02</td>
        <td>dai</td>
      </tr>
      <tr>
        <td>UP8000</td>
        <td>trinity919</td>
        <td>directmessage</td>
      </tr>
      <tr>
        <td>UP7001</td>
        <td>trinity919</td>
        <td>dspec</td>
      </tr>
    </table>
  </div><br>

  <div>
    <h3>Add new Product for User</h3>
    <form>
      <label for="userproductid">UserProduct ID:</label><br>
      <input type="text" id="userproductid" name="userproductid"><br>
      <label for="userid">User ID:</label><br>
      <input type="text" id="userid" name="userid"><br>
      <label for="productID">ProductID:</label><br>
      <input type="text" id="productid" name="productid"><br>
      <button type="submit">Submit</button>
    </form>
  </div><br>
  
  <form>
    <div>
      <h3>Remove UserProduct</h3>
      <label for="users">Choose a UserProduct to remove:</label>
      <select name="users" id="users">
        <option value="UP0001">UP0001</option>
        <option value="UP8000">UP8000</option>
        <option value="UP7001">UP7001</option>
      </select><br>
      
      <button type="submit">Remove UserProduct</button>
    </div>
  </form><br>

  <form>
    <div>
      <h3>Update UserProduct</h3>
      <label for="users">Choose a UserProduct to update:</label>
      <select name="users" id="users">
        <option value="UP0001">UP0001</option>
        <option value="UP8000">UP8000</option>
        <option value="UP7001">UP7001</option>
      </select><br>

      <label for="userid">User ID:</label><br>
      <input type="text" id="userid" name="userid"><br>
      <label for="productID">ProductID:</label><br>
      <input type="text" id="productid" name="productid"><br>
      <button type="submit">Update UserProduct</button>
    </div>
  </form>


</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>
