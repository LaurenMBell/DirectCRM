<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Reset Demo</h1>
      <p></p>
    </div>
  </div>

  <% if (message) { %>
    <div class="alert alert-info" role="alert"><%= message %></div>
  <% } %>

  <div>
    <form action="/resetdemo/delete-rsmith" method="post">
      <button type="submit">Delete Richard Smith (employee) to test demo reset</button>
    </form>
  </div>

  <div>
    <form action="/resetdemo/reset-demo" method="post">
      <button type="submit">Reset demo</button>
    </form>
  </div>

    
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>
