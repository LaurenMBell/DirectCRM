<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Employees</h1>
      <p>Add, update, and delete employees</p>
    </div>
  </div>

  <div>
    <table>
      <thead>
        <tr>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Employee ID</th>
          <th>Manager ID</th>
          <th>Salary</th>
          <th>Email</th>
        </tr>
      </thead>
      <tbody>
        <% employees.forEach(function(employee) { %>
          <tr>
            <td><%= employee.fNameEmp %></td>
            <td><%= employee.lNameEmp %></td>
            <td><%= employee.EmployeeID %></td>
            <td><%= employee.ManagerID %></td>
            <td><%= employee.Salary %></td>
            <td><%= employee.Email %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div><br>

<div>
  <h3>Add New Employee</h3>
  <form></form>
    <label for="fname">First Name:</label><br>
    <input type="text" id="fname" name="fname"><br>
    <label for="lname">Last Name:</label><br>
    <input type="text" id="lname" name="lname"><br>
    <label for="employeeid">Employee ID:</label><br>
    <input type="text" id="employeeid" name="employeeid"><br>
    <label for="managerid">Manager ID:</label><br>
    <input type="text" id="managerid" name="managerid"><br>
    <label for="salary">Salary:</label><br>
    <input type="int" id="salary" name="salary"><br>
    <label for="email">Email:</label><br>
    <input type="text" id="email" name="email"><br>
    <button type="submit">Add new Employee</button>
  </form>
</div><br>

<div>
  <form>
    <div>
      <h3>Remove Employee</h3>
      <label for="employees">Choose a employee to remove:</label>
      <select name="employees" id="employees">
        <option value="rsmith">rsmith</option>
        <option value="ajohnson">ajohnson</option>
        <option value="swilliams">swilliams</option>
        <option value="dgray">dgray</option>
      </select><br>
      
      <button type="submit">Remove Employee</button>
    </div>
  </form>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>
