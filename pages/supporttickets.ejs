<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Support Tickets</h1>
      <p>Add, update, and delete support tickets</p>
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Ticket ID</th>
          <th>Ticket Status</th>
          <th>Description</th>
          <th>User ID</th>
          <th>Employee ID</th>
        </tr>
      </thead>
      <tbody>
        <% supporttickets.forEach(function(supportticket) { %>
          <tr>
            <td><%= supportticket.TicketID %></td>
            <td><%= supportticket.TicketStatus %></td>
            <td><%= supportticket.Description %></td>
            <td><%= supportticket.UserID %></td>
            <td><%= supportticket.EmployeeID %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="flex-container">
  <div class="column">
    <h3>Add New Support Ticket</h3>
    <form action="/supporttickets/add-new-supportticket" method="POST">
      <label for="ticketid">TicketID:</label><br>
      <input type="text" id="ticketid" name="ticketid"><br>
      <label for="status">Ticket Status:</label><br>
      <input type="text" id="status" name="status"><br>
      <label for="description">Description</label><br>
      <input type="text" id="description" name="description"><br>
      <label for="userid">UserID</label><br>
      <input type="text" id="userid" name="userid"><br>
      <label for="employeeid">EmployeeID:</label><br>
      <input type="text" id="employeeid" name="employeeid"><br>
      <button type="submit">Add new Ticket</button>
    </form>
  </div>
  <div class="column">
    <h3>Update Support Ticket Status</h3>
    <form action="/supporttickets/update-supportticket" method="POST">
      <label for="ticketid">Choose Ticket ID to Update:</label><br>
      <select name="ticketid" id="ticketid" required>
        <option value="">Select a Ticket ID</option>
        <% supporttickets.forEach(function(st) { %>
          <option value="<%= st.TicketID %>">ID: <%= st.TicketID %> (Status: <%= st.TicketStatus %>)</option>
        <% }); %>
      </select><br>
      <label for="status">Updated Status:</label><br>
      <select name="status" id="status">
          <option value="pending">Pending</option>
          <option value="completed">Completed</option>
          <option value="unassigned">Unassigned</option>
        </select><br>
      <label for="description">Description</label><br>
      <input type="text" id="description" name="description"><br>
      <label for="userid">UserID</label><br>
      <input type="text" id="userid" name="userid"><br>
      <label for="employeeid">EmployeeID:</label><br>
      <input type="text" id="employeeid" name="employeeid"><br>
      <button type="submit">Update Ticket</button>
    </form>
  </div>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>
