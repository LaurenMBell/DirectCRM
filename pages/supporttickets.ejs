<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../views/partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../views/partials/header'); %>
</header>

<main>
<div class="row">
  <div class="col-sm-8">
    <div class="p-5 mb-4 bg-light rounded-3">
      <h1>Support Tickets</h1>[cite: 7]
      <p>Add, update, and delete support tickets</p>[cite: 7]
    </div>
  </div>

  <div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Ticket ID</th>
          <th>Ticket Status</th>
          <th>Description</th>
          <th>User ID</th>
          <th>Employee ID</th>
        </tr>
      </thead>
      <tbody>
        <% supporttickets.forEach(function(supportticket) { %>
          <tr>
            <td><%= supportticket.TicketID %></td>
            <td><%= supportticket.Status %></td>
            <td><%= supportticket.Description %></td>
            <td><%= supportticket.UserID %></td>
            <td><%= supportticket.EmployeeID %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div><br>


<div>
  <h3>Add New Support Ticket</h3>[cite: 7]
  <form action="/supporttickets/add" method="POST">
    <label for="ticketid">TicketID:</label><br>
    <input type="text" id="ticketid" name="ticketid"><br>
    <label for="status">Ticket Status:</label><br>
    <input type="text" id="status" name="status"><br>
    <label for="description">Description</label><br>
    <input type="text" id="description" name="description"><br>
    <label for="userid">UserID</label><br>
    <input type="text" id="userid" name="userid"><br>
    <label for="employeeid">EmployeeID:</label><br>
    <input type="text" id="employeeid" name="employeeid"><br>
    <button type="submit">Add new Ticket</button>
  </form>
</div><br>

<div>
  <h3>Update Support Ticket Status</h3>[cite: 7]
  <form action="/supporttickets/update" method="POST">
    <label for="ticketid-update">TicketID:</label><br>
    <input type="text" id="ticketid-update" name="ticketid"><br>
    <label for="status-update">Updated Status:</label><br>
    <select name="status" id="status-update">
        <option value="pending">Pending</option>
        <option value="completed">Completed</option>
        <option value="unassigned">Unassigned</option>
      </select><br>
    <button type="submit">Update Ticket Status</button>
  </form>
</div><br>

<div>
  <h3>Remove Support Ticket</h3>
  <form action="/supporttickets/delete" method="POST">
    <label for="remove-ticketid">Choose a ticket to remove:</label><br>
    <select name="ticketid" id="remove-ticketid">
      <% supporttickets.forEach(function(supportticket) { %>
        <option value="<%= supportticket.TicketID %>">Ticket ID: <%= supportticket.TicketID %> (User: <%= supportticket.UserID %>)</option>
      <% }); %>
    </select><br>
    <button type="submit">Remove Ticket</button>
  </form>
</div>
</main>

<footer>
  <%- include('../views/partials/footer'); %>
</footer>

</body>
</html>